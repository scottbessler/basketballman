#!/bin/sh
# Pushing main deploys to Fly, so run the full CI gate locally first.
set -eu
should_run=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in refs/heads/main) should_run=1 ;; esac
done
[ "$should_run" -eq 1 ] || { echo "[pre-push] not pushing main; skipping full local gate"; exit 0; }
cargo fmt --check
cargo check --locked
cargo check --release --locked
cargo clippy --locked --all-targets --all-features
cargo test --locked
echo "[pre-push] ok"
